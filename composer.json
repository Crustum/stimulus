{
    "name": "crustum/stimulus",
    "description": "Stimulus plugin for CakePHP",
    "type": "cakephp-plugin",
    "license": "MIT",
    "keywords": [
        "cakephp",
        "crustum",
        "stimulus"
    ],
    "authors": [
        {
            "name": "Evgeny Tomenko",
            "homepage": "https://github.com/skie"
        }
    ],
    "require": {
        "php": ">=8.3",
        "cakephp/cakephp": "^5.4",
        "laminas/laminas-diactoros": "^3.0",
        "laravel/serializable-closure": "^1.3|^2.0",
        "symfony/polyfill-php84": "^1.31",
        "symfony/process": "^7.0|^8.1",
        "skie/signal_handler": "1.0"
    },
    "require-dev": {
        "boundwize/structarmed": "^0.15",
        "cakedc/cakephp-phpstan": "^4.3",
        "cakephp/bake": "^3.8",
        "crustum/broadcasting": "^1.0",
        "crustum/plugin-manifest": "^1.2",
        "crustum/essentia": "^1.0.2",
        "crustum/explorator": "^1.0",
        "crustum/notification": "^1.0",
        "guzzlehttp/guzzle": "^7.15",
        "cakephp/cakephp-codesniffer": "^5.0",
        "mockery/mockery": "^1.6.15",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^10.5 || ^11.1 || ^12.5 | ^13.0",
        "rector/rector": "^2.7",
        "spiral/roadrunner-cli": "^2.7",
        "spiral/roadrunner-http": "^4.1"
   },
    "autoload": {
        "psr-4": {
            "Crustum\\Stimulus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crustum\\Stimulus\\Test\\": "tests/",
            "TestApp\\": "tests/TestApp/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@analyse"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan": "phpstan analyse src/",
        "stan-baseline": "phpstan analyse --generate-baseline"
    },
    "bin": [
        "bin/roadrunner-worker",
        "bin/stimulus-swoole-server"
    ],
    "extra": {
        "installer-name": "Stimulus"
    },
    "suggest": {
        "crustum/plugin-manifest": "CakePHP plugin installer"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
